NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=  # clé anon ou sb_publishable_… (NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY accepté)
SUPABASE_SERVICE_KEY=            # service_role ou sb_secret_…, serveur uniquement (SUPABASE_SERVICE_ROLE_KEY / SUPABASE_SECRET_KEY acceptés)
NEXT_PUBLIC_CHAIN_ID=97          # 97 = BSC testnet, 56 = BNB Chain
NEXT_PUBLIC_ESCROW_ADDRESS=0x... # sortie de scripts/deploy.js
NEXT_PUBLIC_USDT_ADDRESS=        # MockUSDT sur testnet ; 0x55d398326f99059fF775485246999027B3197955 sur BNB Chain
NEXT_PUBLIC_BNB_USD=612
BSC_RPC=                          # optionnel, un nœud dédié
RELAYER_KEY=0x...                 # clé du relayer (appelle deliver() pour les agents). Petit solde BNB pour le gas.

# x402 (paid registration, 0.10 USDT from the agent's Binance agentic wallet)
X402_PAY_TO=0x...                 # treasury address that receives the registration fees
FACILITATOR_URL=https://facilitator.aeon.xyz
FACILITATOR_API_KEY=              # if the facilitator requires a Bearer key for /verify and /settle
AGENT_ID_CHECK=strict              # soft = accept registration when the .ai registry is unreachable (flagged, re-checked)
