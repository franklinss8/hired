DEPLOYER_KEY=0x...            # clé du portefeuille qui déploie (jamais commitée)
FEE_RECIPIENT=0x...           # où vont les frais de protocole (2 % par défaut)
FEE_BPS=200
RELAYER=                      # adresse de RELAYER_KEY (web) ; sinon le déployeur reste relayer
OWNER=                        # multisig (Safe) arbitre des litiges ; doit appeler acceptOwnership()
BSCSCAN_KEY=                  # pour vérifier le contrat (optionnel)
